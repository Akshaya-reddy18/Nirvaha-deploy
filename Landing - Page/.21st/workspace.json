{
  "name": "Nirvaha Wellness Platform",
  "version": "1.0.0",
  "description": "AI-Powered Holistic Mental Wellness Platform",
  "type": "react-vite",
  "framework": "vite",
  "ui": "tailwind",
  "features": [
    "ai-powered",
    "wellness-platform", 
    "meditation",
    "therapy",
    "community",
    "dashboard",
    "content-library"
  ],
  "components": {
    "total": 50,
    "ui": 15,
    "pages": 8,
    "features": 27
  },
  "styling": {
    "framework": "tailwindcss",
    "theme": "custom-wellness",
    "colors": {
      "primary": ["emerald", "teal", "cyan"],
      "secondary": ["purple", "pink", "blue"]
    }
  },
  "development": {
    "port": 5173,
    "build": "vite build",
    "dev": "vite dev"
  },
  "21st": {
    "enabled": true,
    "version": "0.0.29",
    "extensions": ["react", "toolbar-react"],
    "config": {
      "analyze": true,
      "documentation": true,
      "style-guide": true
    }
  }
}
